# Rehearsal is the default. No real money moves in this mode.
NESLOS_MODE=rehearsal
PORT=8787
HOST=127.0.0.1

# Keep real credentials outside the public demo. Never commit .env.
# NEARAI_API_KEY=
# NEARAI_MODEL= (choose a supported private model from the live catalogue)
# ONECLICK_JWT=
# NESLOS_VAULT_ACCOUNT=
# NESLOS_NETWORK=testnet
# NESLOS_TEE_POLICY_FILE= (independently verified, pinned measurements)
# NESLOS_INFERENCE_POLICY_FILE= (approved gateway/model measurements and modelId)
# NESLOS_OWNER_TOKEN= (random 32-byte hex secret; inject only into the TEE and owner client)
# NESLOS_JOURNAL=/data/neslos-audit.json
# NESLOS_DSTACK_SOCKET=/var/run/dstack.sock
# NESLOS_PUBLIC_ORIGIN=https://your-reviewed-public-demo.example
