# Supply through Phala Encrypted Secrets. Never put real values in this file.
# Start with attestation-only and no owner/inference credentials.
NESLOS_RUNTIME_MODE=attestation-only
NESLOS_NETWORK=testnet
NESLOS_VAULT_ACCOUNT=
NESLOS_TEE_POLICY_JSON=
# For verified owner status/observation/audit without AI, use mode private and false.
# Keep inference policy/key empty in that mode. Default when omitted is true.
NESLOS_INFERENCE_ENABLED=false
NESLOS_INFERENCE_POLICY_JSON=
NESLOS_OWNER_TOKEN=
NEARAI_API_KEY=
ONECLICK_JWT=
# Registry credentials, if required, belong only in the platform encrypted secrets.
